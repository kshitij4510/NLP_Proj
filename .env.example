# ─────────────────────────────────────────────
# ResearchMind Environment Configuration
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.
# ─────────────────────────────────────────────

# ── Environment ──────────────────────────────
ENVIRONMENT=development

# ── PostgreSQL ────────────────────────────────
POSTGRES_USER=researchmind
POSTGRES_PASSWORD=researchmind_secret
POSTGRES_DB=researchmind
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

# Async DSN (used by SQLAlchemy)
DATABASE_URL=postgresql+asyncpg://researchmind:researchmind_secret@postgres:5432/researchmind
# Sync DSN (used by Alembic migrations)
DATABASE_URL_SYNC=postgresql+psycopg2://researchmind:researchmind_secret@postgres:5432/researchmind

# ── Redis ─────────────────────────────────────
REDIS_PASSWORD=redis_secret
REDIS_URL=redis://:redis_secret@redis:6379/0
REDIS_PORT=6379

# ── Backend ───────────────────────────────────
BACKEND_PORT=8000
SECRET_KEY=change_me_to_a_random_64_char_string
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# ── Frontend ──────────────────────────────────
FRONTEND_PORT=5173
VITE_API_BASE_URL=http://localhost:8000

# ── File Storage ─────────────────────────────
UPLOAD_DIR=/app/uploads
MAX_UPLOAD_SIZE_MB=50
ALLOWED_UPLOAD_EXTENSIONS=pdf,txt

# ── NLP / Embeddings ─────────────────────────
# Model for sentence embeddings (local HuggingFace)
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
EMBEDDING_DIMENSION=384
SPACY_MODEL=en_core_web_sm
# Set to "local" to use HuggingFace only; "openai" or "gemini" for cloud
LLM_PROVIDER=demo

# ── LLM Credentials (optional) ────────────────
# Leave blank to run in demo mode
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_BASE_URL=https://api.openai.com/v1

GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash

# ── External Academic APIs (optional) ────────
SEMANTIC_SCHOLAR_API_KEY=
OPENALEX_EMAIL=your_email@example.com
# arXiv does not require a key

# ── Rate Limiting ─────────────────────────────
RATE_LIMIT_REQUESTS_PER_MINUTE=60
RATE_LIMIT_BURST=10

# ── Logging ───────────────────────────────────
LOG_LEVEL=INFO
LOG_FORMAT=json

# ── CORS ──────────────────────────────────────
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# ── Worker ────────────────────────────────────
WORKER_CONCURRENCY=4
JOB_TIMEOUT_SECONDS=3600
JOB_MAX_RETRIES=3
