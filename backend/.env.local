# Local development — SQLite + fakeredis, no Docker needed
ENVIRONMENT=development
SECRET_KEY=local_dev_secret_key_change_in_production_abc123xyz456
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# SQLite (local mode)
DATABASE_URL=sqlite+aiosqlite:///./researchmind_local.db
DATABASE_URL_SYNC=sqlite:///./researchmind_local.db

# Fakeredis sentinel (handled in local_main.py)
REDIS_URL=redis://localhost:6379/0

# No LLM key needed — demo mode
LLM_PROVIDER=demo

# Uploads
UPLOAD_DIR=./uploads
MAX_UPLOAD_SIZE_MB=50
ALLOWED_UPLOAD_EXTENSIONS=["pdf","txt"]

# NLP
EMBEDDING_MODEL=lexical-hash
EMBEDDING_DIMENSION=384
SPACY_MODEL=en_core_web_sm

# CORS — allow local frontend
CORS_ORIGINS=["http://localhost:5173","http://localhost:3000"]

LOG_LEVEL=INFO
